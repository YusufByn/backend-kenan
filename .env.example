# Copier ce fichier en .env puis remplir les valeurs : cp .env.example .env
# Tout est optionnel en dev : sans .env, des valeurs par défaut sont utilisées.

# ---------- Serveur
PORT=3000
# URL publique de l'API (sert à construire l'URL des photos uploadées)
PUBLIC_URL=http://localhost:3000
# "production" active les garde-fous : JWT_SECRET obligatoire, limite de requêtes toujours active
NODE_ENV=development
# Origines autorisées à appeler l'API depuis un navigateur, séparées par des virgules. Vide = toutes (dev)
CORS_ORIGINS=
# true seulement derrière un reverse proxy (Render, Nginx...) : l'IP du client est lue dans X-Forwarded-For
TRUST_PROXY=false
# off = désactive la limite de requêtes (tests automatisés). Ignoré en production
RATE_LIMIT=on

# ---------- Base de données
# Fichier SQLite (créé automatiquement au démarrage)
DATABASE_PATH=db.sqlite

# ---------- Authentification
# Secret qui signe les access tokens. En générer un avec : openssl rand -hex 32
JWT_SECRET=
# Durée de validité d'un access token : 15m, 1h... Court : le refresh token prend le relais
JWT_EXPIRES_IN=15m
# Une session (refresh token) expire après ce nombre de jours sans être utilisée
SESSION_TTL_DAYS=30
# Comptes toujours admin, séparés par des virgules. Deviennent admin une fois leur email vérifié
ADMIN_EMAILS=

# ---------- Emails
# URL du front : les liens des emails (vérification, reset, annonce...) pointent vers ses pages
FRONTEND_URL=http://localhost:5173
# Sans SMTP_HOST, les emails sont affichés dans le terminal du serveur (pratique en dev)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Vélo Marketplace <no-reply@velo-marketplace.local>"

# ---------- Photos
# Dossier où sont stockées les photos uploadées (servi sur /uploads)
UPLOADS_DIR=uploads
