# Copier ce fichier en .env puis remplir les valeurs : cp .env.example .env

# Port de l'API
PORT=3000

# Fichier de la base SQLite (créé automatiquement au démarrage)
DATABASE_PATH=db.sqlite

# Secret qui signe les tokens JWT. En générer un avec : openssl rand -hex 32
JWT_SECRET=
# Durée de validité d'un token : 15m, 12h, 1d, 7d...
JWT_EXPIRES_IN=1d
